<launch>

<rosparam file="$(find Crazyflie_urdf_export_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="Crazyflie_urdf_export" args="joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/Crazyflie_urdf_export/joint_states"/>
</node>

</launch>